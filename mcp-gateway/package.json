{
  "name": "mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Security gateway for MCP: per-client policies, tool pinning, redaction and a hash-chained audit log in front of PayFlow's MCP servers.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "pin": "node --env-file-if-exists=.env dist/pin.js",
    "demo": "node scripts/demo.mjs",
    "verify-audit": "node scripts/verify-audit.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
